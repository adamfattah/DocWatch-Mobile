rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /docs/{docId} {
        // Client may read, delete, and correct the fields it can edit on the detail screen.
        // Everything else (status, issuer, documentNumberLast4, confidence, storagePath...) is server-written.
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.status == 'processing';
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['docType', 'holderName', 'expirationDate', 'renewalDate', 'title', 'needsReview', 'reviewedAt', 'remindersSent'])
          && (!('title' in request.resource.data) || request.resource.data.title is string)
          && (!('docType' in request.resource.data) || request.resource.data.docType is string)
          && (!('holderName' in request.resource.data) || request.resource.data.holderName == null || request.resource.data.holderName is string)
          && (!('expirationDate' in request.resource.data) || request.resource.data.expirationDate == null || request.resource.data.expirationDate is string)
          && (!('renewalDate' in request.resource.data) || request.resource.data.renewalDate == null || request.resource.data.renewalDate is string);
      }
    }
  }
}
